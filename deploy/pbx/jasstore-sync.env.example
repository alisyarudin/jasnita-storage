# /etc/jasstore/sync.env — pengaturan sinkronisasi rekaman PBX -> JasStore
# Folder rekaman Asterisk/FreePBX
SOURCE_DIR=/var/spool/asterisk/monitor
# Tujuan: bucket/prefix. Prefix dipakai untuk membedakan PBX bila lebih dari satu.
DEST=jasstore:recordings/pbx-sip1
# copy  = salin, rekaman tetap ada di PBX (hapus lokal diatur KEEP_DAYS)
# move  = pindahkan, rekaman dihapus dari PBX begitu sukses terunggah
MODE=copy
# Hanya proses berkas yang sudah tidak ditulis selama ini (hindari rekaman yang masih berjalan)
MIN_AGE=2m
# Untuk MODE=copy: hapus berkas lokal yang lebih tua dari N hari DAN sudah ada di storage. 0 = jangan hapus.
KEEP_DAYS=30
# Pola berkas yang diikutkan
INCLUDE=*.wav,*.WAV,*.mp3,*.gsm,*.wav49
# Paralel transfer
TRANSFERS=4
