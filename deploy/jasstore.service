[Unit]
Description=JasStore S3-compatible object storage
After=network.target

[Service]
User=jasstore
Group=jasstore
EnvironmentFile=/etc/jasstore/jasstore.env
ExecStart=/usr/local/bin/jasstore -env /etc/jasstore/jasstore.env
Restart=always
RestartSec=3
LimitNOFILE=65536
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/jasstore
PrivateTmp=true

[Install]
WantedBy=multi-user.target
