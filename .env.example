# Direktori penyimpanan objek + database metadata (SQLite di dalamnya)
JASSTORE_DATA_DIR=/var/lib/jasstore
# Alamat listen API S3 dan console
JASSTORE_S3_ADDR=127.0.0.1:9000
JASSTORE_CONSOLE_ADDR=127.0.0.1:9001
# Region yang dilaporkan (klien bebas memakai region apa pun)
JASSTORE_REGION=ap-southeast-1
# URL publik endpoint S3 (dipakai console untuk contoh .env Laravel)
JASSTORE_PUBLIC_URL=https://s3.jascall.com
# Opsional: aktifkan virtual-host style bucket.<domain>
# JASSTORE_DOMAIN=s3.jascall.com
# Kredensial root (admin). Ganti sebelum produksi.
JASSTORE_ROOT_ACCESS_KEY=jasstore
JASSTORE_ROOT_SECRET_KEY=ganti-dengan-secret-panjang
